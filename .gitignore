# Computer Network - Academic Repository
# Specialized .gitignore for networking and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# Cisco Packet Tracer
*.bak
*.pka
# Note: .pkt files are generally source/project files and kept

# Network Capture & Analysis
*.pcap
*.pcapng
*.cap

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Temporary and Cache files
*.tmp
*.log
.cache/
node_modules/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
